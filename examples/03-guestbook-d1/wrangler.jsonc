{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guestbook-d1",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guestbook-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
